    },
    {
      "id": "1b0feefe-757d-4f38-af77-eb1333dc8059",
      "name": "Rejected Header",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "// One item whose keys are the header names. On an empty tab the Google Sheets node writes these\n// keys as row 1 (the empty values leave row 2 blank). On a tab that already has them, nothing visible changes.\nconst HEADERS = [\"received_at\",\"reason\",\"contact_id\",\"name\",\"email\",\"phone\",\"source\",\"raw_json\"];\nreturn [{ json: Object.fromEntries(HEADERS.map((h) => [h, ''])) }];\n"
      }
    },
