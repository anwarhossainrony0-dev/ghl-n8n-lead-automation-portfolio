    {
      "id": "543de88c-a3c5-4937-a9c2-e0db212de23f",
      "name": "Leads_v2 Header",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// One item whose keys are the header names. On an empty tab the Google Sheets node writes these\n// keys as row 1 (the empty values leave row 2 blank). On a tab that already has them, nothing visible changes.\nconst HEADERS = [\"contact_id\",\"first_seen\",\"last_seen\",\"submission_count\",\"first_name\",\"last_name\",\"email\",\"phone\",\"property_address\",\"help_topic\",\"message\",\"website\",\"source\",\"session_source\",\"utm_source\",\"utm_medium\",\"utm_campaign\",\"country\",\"score\",\"tier\",\"score_reasons\",\"ghl_sync\",\"ghl_opportunity_id\",\"location_name\"];\nreturn [{ json: Object.fromEntries(HEADERS.map((h) => [h, ''])) }];\n"
      }
    },
    {
      "id": "66ed8efe-a98d-48bb-a440-3f53797a0a2d",
      "name": "Write Leads_v2 Headers",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        300
